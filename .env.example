# Plantilla de variables de entorno para Ciphra COMMANDER.
# Copiá este archivo a `.env` y completá los valores reales. NO commitear `.env`.

# --- Claves de IA ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# --- Cifrado de datos en reposo (users.json / chats.json / sessions.json) ---
# VAULT_KEY es obligatoria; el servidor no arranca sin ella.
VAULT_KEY=
# Opcional: clave base de cifrado si no se usa GEMINI_API_KEY como base.
# CIPHRA_BASE_KEY=

# --- Pagos (Ciphra Pro: USD 5 / mes) ---
# Proveedor: link (botón Pagar -> link de cobro MP, aprobación manual) | transfer (alias/CBU)
#            | sandbox (prueba) | stripe | mercadopago (automáticos, requieren API)
PAYMENT_PROVIDER=link
# Cobro REAL automático solo cuando esto es true Y hay credenciales del proveedor.
# 'link' y 'transfer' NO usan esto (son manuales). En false/sin claves, stripe/mp caen a sandbox.
PAYMENTS_LIVE=false
# URL pública del sitio (para back_urls y webhooks). En prod, el dominio real.
PUBLIC_BASE_URL=http://localhost:8000

# Link de Pago (RECOMENDADO sin API): creá un "Link de pago" en tu app de Mercado Pago
# por el monto de Pro y pegá la URL acá. El botón "Pagar" lleva ahí; la plata va a tu cuenta.
PAYMENT_LINK_URL=

# AUTO-APROBACIÓN (modo confianza): al tocar "Ya pagué" se activa Pro al instante, sin que
# confirmes a mano. UX inmediata. RIESGO: alguien puede declarar un pago falso y obtener Pro
# gratis. OK para arranque chico; desactivá (false) o conectá la API de MP cuando crezca.
PAYMENT_AUTO_APPROVE=true

# Transferencia (alias/CBU) como alternativa. Completá TRANSFER_ALIAS para usar este modo.
TRANSFER_ALIAS=
TRANSFER_CBU=
TRANSFER_HOLDER=
TRANSFER_AMOUNT=5000
TRANSFER_CURRENCY=ARS

# Token del panel admin de pagos (elegí uno largo y secreto). Sin esto, el panel queda
# deshabilitado. Se ingresa en /admin-payments.html para aprobar/rechazar transferencias.
ADMIN_TOKEN=

# Stripe (cobra en USD). Requiere cuenta de comerciante de un titular adulto.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago genérico (fallback si no hay token por país). Requiere titular adulto.
MP_ACCESS_TOKEN=
MP_CURRENCY=ARS
MP_PRICE_LOCAL=5000

# Mercado Pago POR PAÍS (AR y BR son cuentas/mercados distintos en MP).
#   AR: cuenta MP Argentina, cobra en ARS.
#   BR: cuenta-comercio MP Brasil (CPF/CNPJ), cobra en BRL, Pix nativo en Checkout Pro.
MP_ACCESS_TOKEN_AR=
MP_PRICE_LOCAL_AR=5000
MP_ACCESS_TOKEN_BR=
MP_PRICE_LOCAL_BR=25

# Belo (LATAM, alternativa a MP). Integración real pendiente; reservado para credenciales.
BELO_API_KEY=

# Regionalización: región por subdominio (int.ciphra.com / latam.ciphra.com) y, dentro de
# LATAM, país por path (latam.ciphra.com/ar -> es/ARS ; /br -> pt/BRL).
# int  -> Stripe (USD), inglés por defecto.
# latam/ar -> Mercado Pago AR (ARS), español.   latam/br -> Mercado Pago BR (BRL, Pix), portugués.
# Para probar local sin DNS: ?region=int | ?region=latam&country=br | ?region=latam&country=ar

# --- CORS: orígenes permitidos, separados por coma ---
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Login con Google (opcional pero recomendado en producción) ---
# Si se define, /api/auth/google-login exige y verifica el ID token de Google.
GOOGLE_CLIENT_ID=

# --- Códigos de canje de plan (opcionales; sin esto, /api/auth/redeem queda deshabilitado) ---
REDEEM_CODE_PRO=
REDEEM_CODE_AETHER=

# Motores pro: 1 = usar 2.5 Flash (barato, sin 429); 0 = usar modelo real (2.5-pro, requiere quota del proyecto pago)
FORCE_FLASH=1
